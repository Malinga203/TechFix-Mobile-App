<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtRepairTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repair"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRepairDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/txtRepairService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtRepairIssue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtRepairCurrentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtEstimatedCost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:hint="Estimated cost"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/edtFinalCost"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:hint="Final cost"
            android:inputType="numberDecimal" />

        <Button
            android:id="@+id/btnSaveRepairCosts"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Save Costs"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnNextRepairStatus"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="Update Repair Progress"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>