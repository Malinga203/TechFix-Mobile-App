<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/techfix_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/techfix_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_part_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/techfix_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="OLED Display Assembly" />

        <TextView
            android:id="@+id/tv_part_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            tools:text="Original quality OLED display with touch digitizer." />

        <TextView
            android:id="@+id/tv_part_compatible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_specialization_badge"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/techfix_primary_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Compatible with: iPhone 12, iPhone 12 Pro" />

        <TextView
            android:id="@+id/tv_part_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/techfix_gold"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="LKR 25,000.00" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/techfix_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Required Quantity"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_part_minus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:text="−"
                android:textAllCaps="false"
                android:textSize="20sp"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/tv_part_quantity"
                android:layout_width="64dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/techfix_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_part_plus"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/techfix_primary"
                app:cornerRadius="12dp" />

            <TextView
                android:id="@+id/tv_part_selected_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/techfix_success"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Selected • Qty 2"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="The assigned branch must have enough stock for this quantity."
            android:textColor="@color/techfix_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
