<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- =========================
             HEADER
             ========================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TECHFIX"
            android:textColor="@color/techfix_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />


        <!-- =========================
             PAGE TITLE
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="start"
            android:text="Create your account"
            android:textColor="@color/techfix_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />


        <!-- =========================
             DESCRIPTION
             Same left/right alignment
             as "Create your account"
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:text="Join TechFix and manage your services with ease."
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />


        <!-- =========================
             NAME
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Full name"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your full name"
            android:inputType="textPersonName"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             EMAIL
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Email address"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="you@example.com"
            android:inputType="textEmailAddress"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             PHONE
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Phone number"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter your phone number"
            android:inputType="phone"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             PASSWORD
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Password"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Create a password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             CONFIRM PASSWORD
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Confirm password"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Re-enter your password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             REGISTER BUTTON
             ========================= -->

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="2dp"
            android:text="Create Account"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- =========================
             BACK TO LOGIN
             ========================= -->

        <Button
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:text="Back to Login"
            android:textAllCaps="false"
            android:textColor="@color/techfix_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>