<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/techfix_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/techfix_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">


        <!-- Repair ID -->

        <TextView
            android:id="@+id/txtPaymentRepairId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repair #1"
            android:textColor="@color/techfix_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- Device -->

        <TextView
            android:id="@+id/txtPaymentDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Samsung Galaxy S23"
            android:textColor="@color/techfix_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- Service -->

        <TextView
            android:id="@+id/txtPaymentService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Screen Replacement"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp" />


        <!-- Status -->

        <TextView
            android:id="@+id/txtPaymentRepairStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Ready For Collection"
            android:textColor="@color/techfix_success"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="@color/techfix_divider" />


        <!-- Amount label -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amount Due"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />


        <!-- Amount -->

        <TextView
            android:id="@+id/txtPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="LKR 18,500.00"
            android:textColor="@color/techfix_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />


        <!-- Payment button -->

        <Button
            android:id="@+id/btnPayRepair"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="Pay Now"
            android:textAllCaps="false" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>