<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtBranchFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Branch"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/edtBranchName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Branch Name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/edtBranchAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Branch Address"
            android:inputType="textPostalAddress"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Branch Location"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtLatitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Latitude"
            android:focusable="false"
            android:clickable="false" />

        <EditText
            android:id="@+id/edtLongitude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Longitude"
            android:focusable="false"
            android:clickable="false"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnUseCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use Current Location"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnSelectOnMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Location on Map"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnSaveBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Branch"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>