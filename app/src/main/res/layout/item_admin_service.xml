<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/techfix_surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/techfix_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtAdminServiceName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen Replacement"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/techfix_text_primary" />

        <TextView
            android:id="@+id/txtAdminServiceCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Screen"
            android:textColor="@color/techfix_text_secondary" />

        <TextView
            android:id="@+id/txtAdminServiceDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Service description"
            android:textColor="@color/techfix_text_secondary" />

        <TextView
            android:id="@+id/txtAdminServicePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="LKR 5000.00"
            android:textStyle="bold"
            android:textColor="@color/techfix_primary" />

        <TextView
            android:id="@+id/txtAdminServiceDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="45 minutes"
            android:textColor="@color/techfix_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditService"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Edit"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnDeleteService"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Delete"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>