<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Repair Service"
            android:textColor="@color/techfix_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Add or update a repair service"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/edtServiceName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:hint="Service Name"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtServiceDescription"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="14dp"
            android:gravity="top|start"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:paddingTop="14dp" />

        <EditText
            android:id="@+id/edtServicePrice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Price"
            android:inputType="numberDecimal"
            android:singleLine="true" />

        <EditText
            android:id="@+id/edtServiceDuration"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Duration in minutes"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Device Type"
            android:textColor="@color/techfix_text_primary"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerServiceType"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Repair Category"
            android:textColor="@color/techfix_text_primary"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerServiceCategory"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <Button
            android:id="@+id/btnSaveService"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="Save Service"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>