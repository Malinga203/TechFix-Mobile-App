<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/techfix_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/techfix_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgMedia"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@color/techfix_primary_light"
            android:contentDescription="Repair image"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMediaTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Repair Update"
                android:textColor="@color/techfix_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMediaType"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="Progress"
                android:textColor="@color/techfix_primary"
                android:textSize="10sp"
                app:chipBackgroundColor="@color/techfix_primary_light"
                app:chipStrokeWidth="0dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvMediaCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Repair progress note"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvMediaMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Technician #1"
            android:textColor="@color/techfix_text_soft"
            android:textSize="11sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>