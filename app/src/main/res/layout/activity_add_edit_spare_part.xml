<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Spare Part"
            android:textColor="@color/techfix_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Add or update a spare part"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp" />


        <!-- Part Name -->

        <EditText
            android:id="@+id/edtPartName"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:hint="Spare Part Name"
            android:inputType="textCapWords"
            android:singleLine="true" />


        <!-- Description -->

        <EditText
            android:id="@+id/edtPartDescription"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="14dp"
            android:gravity="top|start"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:paddingTop="14dp" />


        <!-- Price -->

        <EditText
            android:id="@+id/edtPartPrice"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:hint="Price"
            android:inputType="numberDecimal"
            android:singleLine="true" />


        <!-- Compatible Models -->

        <EditText
            android:id="@+id/edtCompatibleModels"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="14dp"
            android:gravity="top|start"
            android:hint="Compatible Models"
            android:inputType="textMultiLine"
            android:paddingTop="14dp" />


        <!-- Save Button -->

        <Button
            android:id="@+id/btnSaveSparePart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="Save Spare Part"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>