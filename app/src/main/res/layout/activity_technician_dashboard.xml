<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTechnicianWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Technician Dashboard"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/techfix_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage appointments and repair progress"
            android:textColor="@color/techfix_text_secondary"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVerifyAppointment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Verify Appointment"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnMyRepairs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="My Repairs"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTechnicianProfile"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="My Profile"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTechnicianLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="Logout"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>