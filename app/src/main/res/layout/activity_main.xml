<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to TechFix"
            android:textColor="@color/techfix_text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What would you like to do?"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="15sp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp" />


        <Button
            android:id="@+id/btnServices"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Repair Services"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnMyAppointments"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="My Appointments"
            android:textAllCaps="false" />


        <Button
            android:id="@+id/btnRepairTracking"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Track Repairs"
            android:textAllCaps="false" />


        <Button
            android:id="@+id/btnRepairHistory"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Repair History"
            android:textAllCaps="false" />


        <Button
            android:id="@+id/btnSeeProfile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="My Profile"
            android:textAllCaps="false" />


        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="Logout"
            android:textAllCaps="false" />

    </LinearLayout>

</ScrollView>