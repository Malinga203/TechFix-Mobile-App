<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTechnicianFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Technician"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/edtTechnicianName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Technician Name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/edtTechnicianPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Phone Number"
            android:inputType="phone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Login Account"
            android:textColor="@color/techfix_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTechnicianEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:hint="Technician Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/edtTechnicianPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:hint="Password"
            android:inputType="textPassword" />

        <!-- MOBILE SPECIALIZATIONS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Mobile Specializations"
            android:textColor="@color/techfix_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select any mobile repair categories this technician can handle"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutMobileSpecializations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <!-- COMPUTER SPECIALIZATIONS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Computer Specializations"
            android:textColor="@color/techfix_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select any computer repair categories this technician can handle"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutComputerSpecializations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Branch"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerBranch"
            android:layout_width="match_parent"
            android:layout_height="56dp" />

        <Switch
            android:id="@+id/switchAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:checked="true"
            android:text="Available" />

        <Button
            android:id="@+id/btnSaveTechnician"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save Technician" />

    </LinearLayout>

</ScrollView>