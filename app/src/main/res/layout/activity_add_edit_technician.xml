<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTechnicianFormTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Technician"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/edtTechnicianName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Technician Name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/edtTechnicianPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:inputType="phone"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Login Account"
            android:textColor="@color/techfix_primary"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edtTechnicianEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:hint="Technician Email"
            android:inputType="textEmailAddress" />

        <EditText
            android:id="@+id/edtTechnicianPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:hint="Password"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Specialization"
            android:textStyle="bold"
            android:layout_marginTop="18dp" />

        <Spinner
            android:id="@+id/spinnerSpecialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Branch"
            android:textStyle="bold"
            android:layout_marginTop="18dp" />

        <Spinner
            android:id="@+id/spinnerBranch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Switch
            android:id="@+id/switchAvailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available"
            android:checked="true"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnSaveTechnician"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Technician"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>