<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- =========================
             BACK
             ========================= -->

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:text="‹  Back"
            android:textColor="@color/techfix_primary"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- =========================
             PAGE TITLE
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:gravity="start"
            android:text="Change Password"
            android:textColor="@color/techfix_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />


        <!-- =========================
             DESCRIPTION
             ONE LINE + SAME ALIGNMENT
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="none"
            android:text="Create a new secure password for your account."
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />


        <!-- =========================
             CURRENT PASSWORD
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:text="Current Password"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCurrentPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter current password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             NEW PASSWORD
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="New Password"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etNewPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Enter new password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             CONFIRM NEW PASSWORD
             ========================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Confirm New Password"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="Confirm new password"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- =========================
             CHANGE PASSWORD BUTTON
             ========================= -->

        <Button
            android:id="@+id/btnChangePassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="2dp"
            android:text="Change Password"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>