<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/techfix_surface"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/techfix_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgApprovalSample"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:background="@color/techfix_primary_light"
            android:contentDescription="Repair media image"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_camera" />

        <TextView
            android:id="@+id/tvApprovalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Device • Service"
            android:textColor="@color/techfix_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvApprovalCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Repair photo description"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvApprovalMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Repair R-001 • Repairing • Technician #1"
            android:textColor="@color/techfix_text_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvApprovalSampleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:text="Repair Media • Not selected as a sample"
            android:textColor="@color/techfix_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnApproveSample"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Approve as Sample"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btnRejectSample"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Remove Sample"
                android:textAllCaps="false"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>