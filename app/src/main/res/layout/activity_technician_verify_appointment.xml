<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Verify Appointment"
            android:textColor="@color/techfix_text_primary"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Enter the appointment code or scan the customer's QR code."
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp" />


        <!-- MANUAL CODE -->

        <EditText
            android:id="@+id/edtAppointmentCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:hint="TF-APT-000001"
            android:inputType="textCapCharacters"
            android:singleLine="true" />


        <!-- MANUAL VERIFY -->

        <Button
            android:id="@+id/btnVerifyAppointmentCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Verify Appointment Code"
            android:textAllCaps="false" />


        <!-- QR SCAN -->

        <Button
            android:id="@+id/btnScanAppointmentQr"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:text="Scan Appointment QR"
            android:textAllCaps="false" />


        <!-- DETAILS -->

        <LinearLayout
            android:id="@+id/layoutAppointmentDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Valid Appointment"
                android:textColor="@color/techfix_success"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtVerifiedCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Code:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtVerifiedCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Customer:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtVerifiedDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Device:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtVerifiedService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Service:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtVerifiedParts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Spare Parts:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtVerifiedIssue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Issue:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtVerifiedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Appointment:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtVerifiedBranch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Branch:"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp" />


            <!-- CUSTOMER DEVICE PHOTO -->

            <TextView
                android:id="@+id/txtCustomerDevicePhotoLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Customer Device Photo"
                android:textColor="@color/techfix_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/imgVerifiedDevicePhoto"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="10dp"
                android:adjustViewBounds="true"
                android:contentDescription="Customer device photo"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnViewVerifiedDevicePhoto"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="View Full Device Photo"
                android:textAllCaps="false"
                android:visibility="gone" />


            <!-- ACCEPT -->

            <Button
                android:id="@+id/btnAcceptAsRepair"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Accept as Repair"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>