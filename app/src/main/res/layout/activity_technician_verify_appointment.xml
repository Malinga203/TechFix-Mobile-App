<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify Appointment"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/techfix_text_primary" />

        <EditText
            android:id="@+id/edtAppointmentCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:hint="TF-APT-000001"
            android:inputType="textCapCharacters" />

        <Button
            android:id="@+id/btnVerifyCode"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:text="Verify Appointment"
            android:textAllCaps="false" />

        <LinearLayout
            android:id="@+id/layoutAppointmentDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtVerificationResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valid Appointment"
                android:textStyle="bold"
                android:textColor="@color/techfix_success"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txtAppointmentCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Customer" />

            <TextView
                android:id="@+id/txtAppointmentDevice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Device" />

            <TextView
                android:id="@+id/txtAppointmentService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Service" />

            <TextView
                android:id="@+id/txtAppointmentIssue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Issue" />

            <TextView
                android:id="@+id/txtAppointmentDateTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Date" />

            <Button
                android:id="@+id/btnAcceptRepair"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="22dp"
                android:text="Accept as Repair"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>