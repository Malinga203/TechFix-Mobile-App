<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <!-- ================================================= -->
        <!-- BRAND -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.08"
            android:text="TECHFIX"
            android:textColor="@color/techfix_primary"
            android:textSize="30sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- WELCOME -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="52dp"
            android:fontFamily="sans-serif"
            android:text="Welcome back"
            android:textColor="@color/techfix_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3dp"
            android:text="Sign in to continue to your TechFix account."
            android:textColor="@color/techfix_text_secondary"
            android:textSize="16sp" />


        <!-- ================================================= -->
        <!-- EMAIL LABEL -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif-medium"
            android:text="Email"
            android:textColor="@color/techfix_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- EMAIL FIELD -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:elevation="1dp"
            android:fontFamily="sans-serif"
            android:gravity="center_vertical"
            android:hint="Enter your email"
            android:includeFontPadding="false"
            android:inputType="textEmailAddress"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="@color/techfix_text_primary"
            android:textColorHint="@color/techfix_text_soft"
            android:textSize="16sp" />


        <!-- ================================================= -->
        <!-- PASSWORD LABEL -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="Password"
            android:textColor="@color/techfix_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- PASSWORD FIELD WITH SHOW / HIDE -->
        <!-- ================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordInputLayout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:elevation="1dp"
            android:padding="0dp"
            app:boxBackgroundMode="none"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/techfix_primary"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@android:color/transparent"
                android:fontFamily="sans-serif"
                android:gravity="center_vertical"
                android:hint="Enter your password"
                android:includeFontPadding="false"
                android:inputType="textPassword"
                android:minHeight="56dp"
                android:paddingStart="18dp"
                android:paddingTop="0dp"
                android:paddingEnd="8dp"
                android:paddingBottom="0dp"
                android:singleLine="true"
                android:textColor="@color/techfix_text_primary"
                android:textColorHint="@color/techfix_text_soft"
                android:textSize="16sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================================================= -->
        <!-- LOGIN BUTTON -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="4dp"
            android:fontFamily="sans-serif-medium"
            android:minHeight="56dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- LOGIN INFORMATION -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Customers, technicians and administrators use the same login."
            android:textColor="@color/techfix_text_secondary"
            android:textSize="12sp" />


        <!-- ================================================= -->
        <!-- REGISTER LINK -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Don't have an account? "
                android:textColor="@color/techfix_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"
                android:text="Register here"
                android:textColor="@color/techfix_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>