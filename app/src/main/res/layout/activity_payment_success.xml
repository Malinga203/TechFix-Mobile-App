<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">


        <!-- ================================================= -->
        <!-- SUCCESS ICON -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            app:cardBackgroundColor="@color/techfix_primary"
            app:cardCornerRadius="45dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✓"
                android:textColor="@android:color/white"
                android:textSize="44sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Payment Successful"
            android:textColor="@color/techfix_text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Your payment has been received successfully"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="14sp" />


        <!-- ================================================= -->
        <!-- AMOUNT -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtSuccessAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="LKR 0.00"
            android:textColor="@color/techfix_text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Amount Paid"
            android:textColor="@color/techfix_text_secondary"
            android:textSize="13sp" />


        <!-- ================================================= -->
        <!-- RECEIPT CARD -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardBackgroundColor="@color/techfix_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/techfix_border"
            app:strokeWidth="1dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">


                <!-- HEADER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">


                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Payment Receipt"
                        android:textColor="@color/techfix_text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_payment_status_success"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="PAID"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="18dp"
                    android:background="@color/techfix_divider" />


                <!-- ORDER ID -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order ID"
                    android:textColor="@color/techfix_text_secondary"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/txtSuccessOrderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="TECHFIX-000"
                    android:textColor="@color/techfix_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- PAYHERE REFERENCE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="PayHere Reference"
                    android:textColor="@color/techfix_text_secondary"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/txtSuccessReference"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Reference"
                    android:textColor="@color/techfix_text_primary"
                    android:textIsSelectable="true"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- APPOINTMENT -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="Appointment ID"
                    android:textColor="@color/techfix_text_secondary"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/txtSuccessAppointmentId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="@color/techfix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- REPAIR ID -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="Repair ID"
                    android:textColor="@color/techfix_text_secondary"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/txtSuccessRepairId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textColor="@color/techfix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <!-- DATE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:text="Payment Date"
                    android:textColor="@color/techfix_text_secondary"
                    android:textSize="12sp" />


                <TextView
                    android:id="@+id/txtSuccessDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="2026-08-23 17:00:00"
                    android:textColor="@color/techfix_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />


            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- SAVE RECEIPT -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveReceipt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="26dp"
            android:text="Save Receipt"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/techfix_primary"
            app:cornerRadius="15dp" />


        <!-- ================================================= -->
        <!-- DONE -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp"
            android:backgroundTint="@android:color/transparent"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="@color/techfix_text_primary"
            android:textSize="15sp"
            app:cornerRadius="15dp"
            app:strokeColor="@color/techfix_border"
            app:strokeWidth="1dp" />


    </LinearLayout>

</ScrollView>