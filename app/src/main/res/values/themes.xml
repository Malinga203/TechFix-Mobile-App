<?xml version="1.0" encoding="utf-8"?>

<resources xmlns:tools="http://schemas.android.com/tools">


    <!-- =========================================================
         BASE TECHFIX THEME
         ========================================================= -->

    <style
        name="Base.Theme.TechFix"
        parent="Theme.Material3.Light.NoActionBar">


        <!-- PRIMARY -->
        <item name="colorPrimary">
            @color/techfix_primary
        </item>

        <item name="colorOnPrimary">
            @color/white
        </item>

        <item name="colorPrimaryContainer">
            @color/techfix_primary_light
        </item>

        <item name="colorOnPrimaryContainer">
            @color/techfix_primary_dark
        </item>


        <!-- SECONDARY -->
        <item name="colorSecondary">
            @color/techfix_accent
        </item>

        <item name="colorOnSecondary">
            @color/techfix_text_primary
        </item>

        <item name="colorSecondaryContainer">
            @color/techfix_accent_light
        </item>

        <item name="colorOnSecondaryContainer">
            @color/techfix_text_primary
        </item>


        <!-- SURFACE -->
        <item name="colorSurface">
            @color/techfix_surface
        </item>

        <item name="colorOnSurface">
            @color/techfix_text_primary
        </item>

        <item name="colorSurfaceVariant">
            @color/techfix_surface_alt
        </item>


        <!-- BACKGROUND -->
        <item name="android:colorBackground">
            @color/techfix_background
        </item>

        <item name="android:windowBackground">
            @color/techfix_background
        </item>


        <!-- STATUS BAR -->
        <item name="android:statusBarColor">
            @color/techfix_primary_dark
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>


        <!-- NAVIGATION BAR -->
        <item name="android:navigationBarColor">
            @color/techfix_surface
        </item>

        <item name="android:windowLightNavigationBar">
            true
        </item>


        <!-- FONT -->
        <item name="android:fontFamily">
            sans
        </item>


        <!-- MATERIAL BUTTON -->
        <item name="materialButtonStyle">
            @style/Widget.TechFix.Button.Primary
        </item>

    </style>


    <!-- =========================================================
         NORMAL APP THEME
         ========================================================= -->

    <style
        name="Theme.TechFix"
        parent="Base.Theme.TechFix" />


    <!-- =========================================================
         LOGIN THEME
         Removes black window between Splash and Login
         ========================================================= -->

    <style
        name="Theme.TechFix.Login"
        parent="Theme.TechFix">

        <!--
            Login XML load wenakan
            same app background color pennanawa.
        -->
        <item name="android:windowBackground">
            @color/techfix_background
        </item>


        <item name="android:colorBackground">
            @color/techfix_background
        </item>


        <!-- Status Bar -->
        <item name="android:statusBarColor">
            @color/techfix_primary_dark
        </item>

        <item name="android:windowLightStatusBar">
            false
        </item>


        <!-- Navigation Bar -->
        <item name="android:navigationBarColor">
            @color/techfix_background
        </item>

        <item name="android:windowLightNavigationBar">
            true
        </item>


        <!-- Disable default Activity animation -->
        <item name="android:windowAnimationStyle">
            @null
        </item>

    </style>


</resources>