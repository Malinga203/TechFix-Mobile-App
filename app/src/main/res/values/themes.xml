<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.TechFix" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/techfix_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/techfix_primary_light</item>
        <item name="colorOnPrimaryContainer">@color/techfix_primary_dark</item>

        <item name="colorSecondary">@color/techfix_accent</item>
        <item name="colorOnSecondary">@color/techfix_text_primary</item>
        <item name="colorSecondaryContainer">@color/techfix_accent_light</item>
        <item name="colorOnSecondaryContainer">@color/techfix_text_primary</item>

        <item name="colorSurface">@color/techfix_surface</item>
        <item name="colorOnSurface">@color/techfix_text_primary</item>
        <item name="colorSurfaceVariant">@color/techfix_surface_alt</item>

        <item name="android:colorBackground">@color/techfix_background</item>
        <item name="android:windowBackground">@color/techfix_background</item>

        <item name="android:statusBarColor">@color/techfix_primary_dark</item>
        <item name="android:navigationBarColor">@color/techfix_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>

        <item name="materialButtonStyle">@style/Widget.TechFix.Button.Primary</item>
    </style>

    <style name="Theme.TechFix" parent="Base.Theme.TechFix" />

</resources>
