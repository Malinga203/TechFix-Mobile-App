<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">

        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="2dp"
                android:color="#2563EB" />

            <corners android:radius="14dp" />

            <padding
                android:left="16dp"
                android:top="4dp"
                android:right="16dp"
                android:bottom="4dp" />

        </shape>

    </item>

    <item>

        <shape android:shape="rectangle">

            <solid android:color="#FFFFFF" />

            <stroke
                android:width="1dp"
                android:color="#D7DEE9" />

            <corners android:radius="14dp" />

            <padding
                android:left="16dp"
                android:top="4dp"
                android:right="16dp"
                android:bottom="4dp" />

        </shape>

    </item>

</selector>