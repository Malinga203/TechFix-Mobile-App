<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TechFix">

        <!-- ================================================= -->
        <!-- MAIN APPLICATION ACTIVITY -->
        <!-- ================================================= -->

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>


        <!-- ================================================= -->
        <!-- USER AUTHENTICATION -->
        <!-- ================================================= -->

        <activity
            android:name=".userauthentication.activities.AuthDatabaseTestActivity"
            android:exported="false" />

        <activity
            android:name=".userauthentication.activities.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".userauthentication.activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".userauthentication.activities.SessionTestActivity"
            android:exported="false" />

        <activity
            android:name=".userauthentication.activities.LogoutTestActivity"
            android:exported="false" />

        <activity
            android:name=".userauthentication.activities.CustomerProfileActivity"
            android:exported="false" />

        <activity
            android:name=".userauthentication.activities.AdminLoginActivity"
            android:exported="false" />

        <activity
            android:name=".userauthentication.activities.ChangePasswordActivity"
            android:exported="false" />


        <!-- ================================================= -->
        <!-- PAYMENT -->
        <!-- ================================================= -->

        <activity
            android:name=".activities.PaymentActivity"
            android:exported="false" />


        <!-- ================================================= -->
        <!-- TECHNICIAN -->
        <!-- ================================================= -->

        <activity
            android:name=".activities.AddEditTechnicianActivity"
            android:exported="false" />

        <activity
            android:name=".activities.TechnicianActivity"
            android:exported="false" />


        <!-- ================================================= -->
        <!-- SERVICES / BOOKING -->
        <!-- ================================================= -->

        <activity
            android:name=".activities.ServiceListActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BookRepairActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SparePartActivity"
            android:exported="false" />


        <!-- ================================================= -->
        <!-- BRANCH / MAP -->
        <!-- ================================================= -->

        <activity
            android:name=".activities.MapPickerActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddEditBranchActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BranchActivity"
            android:exported="false" />


        <!-- ================================================= -->
        <!-- FILE PROVIDER -->
        <!-- ================================================= -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

    </application>

</manifest>