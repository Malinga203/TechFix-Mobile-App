        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TechFix"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".activities.BranchInventoryActivity"
            android:exported="false" />
        <!-- ================================================= -->
        <!-- SPARE PART MANAGEMENT -->
        <!-- ================================================= -->
        <activity
            android:name=".activities.AddEditSparePartActivity"
            android:exported="false" />
        <activity
            android:name=".activities.SparePartManagementActivity"
            android:exported="false" /> <!-- ================================================= -->
        <!-- SERVICE MANAGEMENT -->
        <!-- ================================================= -->
        <activity
            android:name=".activities.AddEditServiceActivity"
